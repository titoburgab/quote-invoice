# --- Next.js frontend (safe to expose to the browser, protected by Supabase RLS) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# n8n webhook endpoints the frontend calls
N8N_INTAKE_WEBHOOK_URL=
N8N_APPROVAL_WEBHOOK_URL=

# --- Server-only: local tooling scripts (tools/supabase, tools/n8n) ---
# Never expose this to the frontend/browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Reference only: these live in n8n's own credential store, not read by this repo ---
# ANTHROPIC_API_KEY=
# RESEND_API_KEY=
